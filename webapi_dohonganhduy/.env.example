# Mẫu biến môi trường cho ConAn Web API (Đỗ Hồng Anh Duy)
# Production (máy server): copy thành .env        → npm start  / Windows service, cổng 3000
# Dev (máy server/dev):    copy thành .env.development → npm run dev, cổng 4000, database _dev
# Không commit file .env thật.

NODE_ENV=production
PORT=3000

# MongoDB Atlas, cluster Cluster-DoHongAnhDuy
MONGODB_URI=mongodb+srv://<user>:<password>@cluster-dohonganhduy.xxxxx.mongodb.net/?retryWrites=true&w=majority
# production: ConAnDB_DoHongAnhDuy · dev: ConAnDB_DoHongAnhDuy_dev · test: ConAnDB_DoHongAnhDuy_test
MONGODB_DB_NAME=ConAnDB_DoHongAnhDuy

# Chuỗi ngẫu nhiên dài (tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
ACCESS_TOKEN_TTL=15m
# Claim iss và aud trong JWT, server từ chối token có iss/aud khác. Không khai báo thì server dùng đúng hai giá trị này.
JWT_ISSUER=webapi-dohonganhduy
JWT_AUDIENCE=conan-app
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=change-me-otp-pepper

# Email OTP: gmail (production) | brevo (dự phòng) | console (chỉ dùng khi dev, in mã ra terminal)
EMAIL_PROVIDER=gmail
GMAIL_USER=your.team.email@gmail.com
# App Password 16 ký tự, tạo ở https://myaccount.google.com/apppasswords (cần bật xác minh 2 bước trước)
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
MAIL_FROM_EMAIL=your.team.email@gmail.com
MAIL_FROM_NAME=ConAn

# Firebase service account JSON mã hoá base64 (tuỳ chọn, thiếu thì bỏ qua push)
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

APP_TIMEZONE=Asia/Ho_Chi_Minh
PUBLIC_BASE_URL=https://webapi-dohonganhduy.<tailnet>.ts.net

# Tài khoản tạo bởi `npm run seed` (email phải là email thật để nhận OTP)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULLNAME=Quản trị viên ConAn
SEED_STAFF_USERNAME=staff
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_STAFF_FULLNAME=Nhân viên hỗ trợ
SEED_PARENT_USERNAME=user1
SEED_PARENT_EMAIL=
SEED_PARENT_PASSWORD=
SEED_PARENT_FULLNAME=Phụ huynh 1
SEED_PARENT2_USERNAME=user2
SEED_PARENT2_EMAIL=
SEED_PARENT2_PASSWORD=
SEED_PARENT2_FULLNAME=Phụ huynh 2
