<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- CHỈ bản debug: cho phép HTTP thường để nối server dev (http://localhost:4000 qua adb reverse,
         http://10.0.2.2:4000 trên emulator). Bản release vẫn bắt buộc HTTPS (Tailscale Funnel). -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic" />
</manifest>
